# ClawAgent gateway environment — set these as Railway service variables.
# Never commit a real .env; this file documents the required keys only.

# --- Server ---
# PORT is injected by Railway automatically; local default is 8080.
PORT=8080
# Comma-separated list of allowed browser origins (the deployed frontend URL).
FRONTEND_ORIGIN=https://your-frontend.example.com,http://localhost:8080
# Public URL of this gateway (used for Twilio webhook signature validation).
PUBLIC_BASE_URL=https://clawagent-production-6805.up.railway.app

# --- Supabase (project mmfostoacpcnbqjbwpxq) ---
SUPABASE_URL=https://mmfostoacpcnbqjbwpxq.supabase.co
SUPABASE_SERVICE_KEY=

# --- LLM (OpenRouter) ---
OPENROUTER_API_KEY=
# Optional override; default model is set in server/lib/config.js
# OPENROUTER_MODEL=anthropic/claude-sonnet-4

# --- Voice (xAI Grok Voice realtime; omit to run browser-speech fallback) ---
XAI_API_KEY=
# Optional endpoint overrides if xAI's realtime API paths change:
# XAI_SESSION_URL=https://api.x.ai/v1/realtime/sessions
# XAI_REALTIME_URL=wss://api.x.ai/v1/realtime
# XAI_VOICE_MODEL=grok-voice

# --- Telephony (Twilio; inbound number (762) 334-0186) ---
TWILIO_SID=
TWILIO_AUTH=
TWILIO_FROM=+17623340186

# --- Alerts (ntfy publish-then-readback attestation) ---
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh

# --- Operator / QA gate ---
# Bearer token the Telegram approval bot uses against /api/admin/audits/:id/review
OPERATOR_TOKEN=
